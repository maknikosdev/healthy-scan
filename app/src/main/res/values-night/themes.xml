<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- In dark mode the two brand colors swap roles: deep green becomes the
         surface/background, cream becomes the accent/text-on-dark color. -->
    <style name="Theme.HealthyScan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_deep_green</item>
        <item name="android:statusBarColor">@color/brand_deep_green</item>
        <item name="android:navigationBarColor">@color/brand_deep_green</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <!-- Smooth fade instead of a black flash when the Activity recreates
             (needed on API < 33 when the EL/EN language toggle is used). -->
        <item name="android:windowAnimationStyle">@style/HealthyScanWindowAnimation</item>
    </style>

    <style name="Theme.HealthyScan.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_deep_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_placeholder</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_deep_green</item>
        <item name="postSplashScreenTheme">@style/Theme.HealthyScan</item>
    </style>

    <style name="HealthyScanWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

</resources>
