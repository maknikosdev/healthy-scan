<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally transparent. The OS SplashScreen API (API 31+) always
     masks whatever drawable goes here into a circle/squircle, so instead of
     fighting that, we keep this invisible and show the FULL, unmasked logo
     ourselves in a custom Compose splash right after (see MainActivity.kt /
     SplashContent()). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
